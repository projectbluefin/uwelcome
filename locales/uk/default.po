msgstr "Банер вимкнено."

#: internal/internal.go:18
msgctxt "Before an error message"
msgid "Error:"
msgstr "Помилка:"

#: internal/internal.go:19
msgctxt "Before a warning message"
msgid "Warning:"
msgstr "Попередження:"

#: main.go:77
msgid "Invalid command."
msgstr "Неправильна команда."

#: cmd/usage.go:13
msgid "uWelcome is a customizable terminal banner for Linux."
msgstr "uWelcome — це банер у терміналі для Linux, який можна налаштувати."

#: cmd/usage.go:14
msgid "Usage:"
msgstr "Використання:"

#: cmd/usage.go:18
msgid "The commands are:"
msgstr "Команди:"

#: cmd/usage.go:19
msgid "disable the terminal banner"
msgstr "вимкнути банер у терміналі"

#: cmd/usage.go:20
msgid "open your uwelcome config file with your default `$EDITOR`"
msgstr ""
"відкрити файл конфігурації uwelcome у вашому типовому редакторі `$EDITOR`"

#: cmd/usage.go:21
msgid "enable the terminal banner"
msgstr "увімкнути банер у терміналі"

#: cmd/usage.go:22
msgid "show this menu"
msgstr "показати це меню"

#: cmd/usage.go:23
msgid "reset your uwelcome config file to the system default"
msgstr "скинути файл конфігурації uwelcome до системних налаштувань"

#: cmd/usage.go:24
msgid "show the path and status of your uwelcome config"
msgstr "показати шлях і стан конфігурації uwelcome"

#: cmd/usage.go:25
msgid "toggle the terminal banner"
msgstr "увімкнути або вимкнути банер у терміналі"

#: cmd/usage.go:26
msgid "print uwelcome version"
msgstr "показати версію uwelcome"

#: cmd/status.go:21
msgid ""
"The config file doesn't exist (yet). uWelcome will use either your system's "
"config or the default."
msgstr ""
"Файлу конфігурації (поки що) немає. uWelcome використає системну або "
"стандартну конфігурацію."

#: cmd/status.go:26
#, go-format
msgid ""
"Your config file's version isn't supported by this version of uWelcome. This"
" version supports config version %d. uWelcome will use either your system's "
"config or the default."
msgstr ""
"Версія вашого файлу конфігурації не підтримується цією версією uWelcome. Ця "
"версія підтримує конфігурацію версії %d. uWelcome використає системну або "
"стандартну конфігурацію."

#: cmd/status.go:31
msgid ""
"There is something wrong with the config file. uWelcome will use either your"
" system's config or the default."
msgstr ""
"З файлом конфігурації щось не так. uWelcome використає системну або "
"стандартну конфігурацію."

#: cmd/status.go:35
msgid "Unknown keys have been detected in your config file."
msgstr "У вашому файлі конфігурації виявлено невідомі ключі."

#: cmd/status.go:39
msgid "The config file is OK."
msgstr "Файл конфігурації в порядку."

#: cmd/edit.go:18
msgid "Failed to access the config path."
msgstr "Не вдалося отримати доступ до шляху конфігурації."

#: cmd/edit.go:22
msgid "Failed to create the default config."
msgstr "Не вдалося створити стандартну конфігурацію."

#: cmd/edit.go:39
msgid "Failed to edit the config file."
msgstr "Не вдалося відредагувати файл конфігурації."

#: cmd/reset.go:20
#, go-format
msgid "Are you sure? This will reset your config file (%s) (yes/NO)"
msgstr "Ви впевнені? Буде скинуто ваш файл конфігурації (%s) (так/НІ)"

#: cmd/reset.go:25
msgid "There was an error parsing your answer."
msgstr "Під час обробки вашої відповіді сталася помилка."

#: cmd/reset.go:37
msgctxt "Word used to give an affirmative response (lower case only)"
msgid "yes"
msgstr "так"

#: cmd/reset.go:38
msgctxt ""
"First letter of the word used to give an affirmative response (lower case "
"only)"
msgid "y"
msgstr "т"

#: cmd/reset.go:42
msgid "Failed to reset the config file."
msgstr "Не вдалося скинути файл конфігурації."

#: cmd/reset.go:45
msgid "Config file reset successfully."
msgstr "Файл конфігурації успішно скинуто."

#: cmd/reset.go:48
msgid "Config file untouched."
msgstr "Файл конфігурації не змінено."

#: cmd/enable.go:14
msgid "The banner is already enabled."
msgstr "Банер уже увімкнено."

#: cmd/disable.go:12
msgid "The banner is already disabled."
msgstr "Банер уже вимкнено."
