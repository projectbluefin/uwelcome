msgstr "Оновити систему вручну"

#: internal/render/build.go:87
msgid "View system information"
msgstr "Переглянути відомості про систему"

#: internal/render/build.go:89
msgid "Enable terminal bling"
msgstr "Увімкнути оформлення терміналу (bling)"

