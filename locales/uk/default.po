#: internal/state/state.go:35 internal/state/state.go:50
msgid "Failed to get the disabled file path."
msgstr "Не вдалося отримати шлях до файлу вимкнення."

#: internal/state/state.go:40
msgid "Failed to enable the banner."
msgstr "Не вдалося увімкнути банер."

#: internal/state/state.go:43
msgid "The banner has been enabled."
msgstr "Банер увімкнено."

