#: internal/config/handling.go:82
msgid "The config file is OK."
msgstr "Le fichier de configuration est bon."

#: internal/config/handling.go:84
msgid ""
"The config file doesn't exist (yet). uWelcome will use either your system's "
"config or the default."
msgstr ""
"Le fichier de configuration n'existe pas (encore). uWelcome va utiliser la "
"configuration du système ou la configuration par défaut."

#: internal/config/handling.go:86
msgid ""
"There is something wrong with the config file. uWelcome will use either your "
"system's config or the default."
msgstr ""
"Quelque chose cloche avec le fichier de configuration. uWelcome va utiliser "
"la configuration du système ou la configuration par défaut."

#: internal/config/handling.go:135
msgid "Failed to access the config path."
msgstr "Impossible d'accéder au chemin du fichier de configuration."

#: internal/config/handling.go:139
msgid "Failed to create the default config."
msgstr "Échec de la création de la configuration par défaut."

#: internal/config/handling.go:156
msgid "Failed to edit the config file."
msgstr "Échec de l'édition du fichier de configuration."

#: internal/config/handling.go:167
#, go-format
msgid "Are you sure? This will reset your configuration file (%s) (yes/NO)"
msgstr ""
"Êtes-vous sûr ? Cela va réinitialiser votre configuration (%s) (oui/NON)"

#: internal/config/handling.go:170
msgid "There was an error in processing your answer"
msgstr "Une erreur s'est produite lors du traitement de votre réponse"

#: internal/config/handling.go:185
msgctxt ""
"Single word affirmative response in response to a question (lower case only)"
msgid "yes"
msgstr "oui"

#: internal/config/handling.go:186
msgctxt ""
"First letter of the single word affirmative response in response to a "
"question (lower case only)"
msgid "y"
msgstr "o"

#: internal/config/handling.go:191
msgid "Failed to reset the configuration file."
msgstr "Échec de la réinitialisation du fichier de configuration. "

#: internal/config/handling.go:193
msgid "Config file reset successfully."
msgstr "Fichier de configuration réinitialisé avec succès."

#: internal/render/render.go:75 internal/render/render.go:89
msgid "An error occured while rendering the banner."
msgstr "Une erreur s'est produite lors du rendu de la bannière."

#: internal/render/render.go:83
msgid "An error occured while loading the renderer."
msgstr "Une erreur s'est produite lors du chargement du moteur de rendu."

#: internal/state/state.go:18
msgid "Failed to enable the banner."
msgstr "Échec de l'activation de la bannière."

#: internal/state/state.go:21
msgid "The banner has been enabled."
msgstr "La bannière a été activé."

#: internal/state/state.go:28 internal/state/state.go:33
msgid "Failed to disable the banner."
msgstr "Échec de la désactivation de la bannière."

#: internal/state/state.go:36
msgid "The banner has been disabled."
msgstr "La bannière a été désactivé."

#: internal/internal.go:16
msgctxt "Before an error message"
msgid "Error:"
msgstr "Erreur :"

#: internal/internal.go:17
msgctxt "Before a warning message"
msgid "Warning:"
msgstr "Attention :"

#: internal/usage.go:13
msgid "uWelcome is a customizable terminal banner for Linux."
msgstr "uWelcome est une bannière de terminal personnalisable pour Linux."

#: internal/usage.go:14
msgid "Usage:"
msgstr "Utilisation :"

#: internal/usage.go:18
msgid "The commands are:"
msgstr "Les commandes sont :"

#: internal/usage.go:19
msgid "disable the terminal banner"
msgstr "désactive la bannière de terminal"

#: internal/usage.go:20
msgid "open your uwelcome config file with your default `$EDITOR`"
msgstr "ouvre votre configuration uwelcome avec votre `$EDITOR` par défaut"

#: internal/usage.go:21
msgid "enable the terminal banner"
msgstr "active la bannière de terminal"

#: internal/usage.go:22
msgid "show this menu"
msgstr "affiche ce menu"

#: internal/usage.go:23
msgid "reset your uwelcome config file to the system default"
msgstr "réinitialise votre configuration uwelcome à celle du système"

#: internal/usage.go:24
msgid "show the location and status of your uwelcome config"
msgstr "affiche l'emplacement et l'état de votre configuration uwelcome"

#: internal/usage.go:25
msgid "toggle the terminal banner"
msgstr "active/désactive la bannière de terminal"

#: internal/usage.go:26
msgid "print uwelcome version"
msgstr "affiche la version de uwelcome"

